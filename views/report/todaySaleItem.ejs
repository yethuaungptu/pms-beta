<!DOCTYPE html>
<html lang="en">
  <head>
    <% include ../partial/head %>
    <link rel="stylesheet" href="/stylesheets/dataTables.bootstrap5.css" />
  </head>
  <body>
    <!-- Start Homepage section-->
    <div class="wrapper">
      <!-- Sidebar -->
      <% include ../partial/sidebar %>
      <div class="main">
        <nav class="navbar navbar-expand px-3 border-bottom">
          <!--Button for sidebar toggle-->
          <button class="btn" type="button" data-bs-theme="dark">
            <span class="navbar-toggler-icon"></span>
          </button>
        </nav>
        <main class="content px-3 py-2">
          <div class="container-fluid">
            <div class="mb-3">
              <h1>Today Sale Item Report</h1>
            </div>
            <div class="row my-5">
              <div class="col-lg-2 col-md-12 col-sm-12"></div>
              <div class="col-lg-8 col-md-12 col-sm-12">
                <table class="table" id="example">
                  <thead>
                    <th>No</th>
                    <th>Item</th>
                    <th>Quantity</th>
                  </thead>
                  <tbody>
                    <% for(var i = 0; i < info.length;i++){%>
                    <tr>
                      <td><%= i+ 1 %></td>
                      <td><%= info[i].name %></td>
                      <td><%= info[i].quantity %></td>
                    </tr>
                    <%}%>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
  <% include ../partial/script %>
  <script src="/javascripts/dataTables.js"></script>
  <script src="/javascripts/dataTables.bootstrap5.js"></script>
  <script>
    new DataTable("#example");
  </script>
</html>
